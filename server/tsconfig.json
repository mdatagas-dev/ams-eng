{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "../dist/server",
    "target": "ES2022"
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}
