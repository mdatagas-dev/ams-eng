{
  "name": "ams-eng",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "dev:api": "tsx watch server/index.ts",
    "postinstall": "prisma generate",
    "build": "next build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "next start",
    "start:api": "node dist/server/index.js",
    "test": "node --import tsx --test server/*.test.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "qrcode-svg": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "esbuild@0.28.1": true,
    "fsevents": true,
    "prisma@7.9.0": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "find-my-way": "9.7.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  }
}
